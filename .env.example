MONGO_URI=
PORT=3000
JWT_SECRET=
# Shared demo accounts (comma-separated usernames) — can't reset data, change username or change password. Default: demo01
# DEMO_USERNAMES=demo01

# Catat Cepat (AI) — any OpenAI-compatible chat-completions API. Gemini (free tier):
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
# Tried in order when the model above is overloaded, rate-limited or times out.
LLM_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Optional, default "low". "default" leaves it to the provider.
# LLM_REASONING_EFFORT=low

# Pro Lifetime checkout — Midtrans Snap. Sandbox keys (SB-Mid-server-…/SB-Mid-client-…) from
# dashboard.midtrans.com → Settings → Access Keys. Payment Notification URL: <API>/api/payments/midtrans/notify
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
# Optional, default 149000 (IDR, one-time).
# PRO_LIFETIME_PRICE=149000
