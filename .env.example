MONGO_URI=
PORT=3000
JWT_SECRET=

# Catat Cepat (AI) — any OpenAI-compatible chat-completions API. Gemini (free tier):
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
# Tried in order when the model above is overloaded, rate-limited or times out.
LLM_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Optional, default "low". "default" leaves it to the provider.
# LLM_REASONING_EFFORT=low
